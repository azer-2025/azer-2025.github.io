span class=\"line\">97</span><br><span class=\"line\">98</span><br><span class=\"line\">99</span><br><span class=\"line\">100</span><br><span class=\"line\">101</span><br><span class=\"line\">102</span><br><span class=\"line\">103</span><br><span class=\"line\">104</span><br><span class=\"line\">105</span><br><span class=\"line\">106</span><br><span class=\"line\">107</span><br><span class=\"line\">108</span><br><span class=\"line\">109</span><br><span class=\"line\">110</span><br><span class=\"line\">111</span><br><span class=\"line\">112</span><br></pre></td><td class=\"code\"><pre><span class=\"line\">&lt;template&gt;</span><br><span class=\"line\">  &lt;a-modal v-model:visible=&quot;visible&quot; title=&quot;编辑图片&quot; :footer=&quot;false&quot; @cancel=&quot;closeModal&quot;&gt;</span><br><span class=\"line\">    &lt;vue-cropper ref=&quot;cropperRef&quot; :img=&quot;imageUrl&quot; :autoCrop=&quot;true&quot; :fixedBox=&quot;false&quot; :centerBox=&quot;true&quot; :canMoveBox=&quot;true&quot;</span><br><span class=\"line\">      :info=&quot;true&quot; outputType=&quot;png&quot; /&gt;</span><br><span class=\"line\">    &lt;!-- 图片操作 --&gt;</span><br><span class=\"line\">    &lt;div style=&quot;margin-bottom: 16px;&quot;&gt;&lt;/div&gt;</span><br><span class=\"line\">    &lt;div class=&quot;image-cropper-action&quot;&gt;</span><br><span class=\"line\">      &lt;a-space&gt;</span><br><span class=\"line\">        &lt;a-button @click=&quot;rotateLeft&quot;&gt;向左旋转&lt;/a-button&gt;</span><br><span class=\"line\">        &lt;a-button @click=&quot;rotateRight&quot;&gt;向右旋转&lt;/a-button&gt;</span><br><span class=\"line\">        &lt;a-button @click=&quot;changeScale(1)&quot;&gt;放大&lt;/a-button&gt;</span><br><span class=\"line\">        &lt;a-button @click=&quot;changeScale(-1)&quot;&gt;缩小&lt;/a-button&gt;</span><br><span class=\"line\">        &lt;a-button type=&quot;primary&quot; :loading=&quot;loading&quot; @click=&quot;handleConfirm&quot;&gt;确认</span><br><span class=\"line\">        &lt;/a-button&gt;</span><br><span class=\"line\">      &lt;/a-space&gt;</span><br><span class=\"line\">    &lt;/div&gt;</span><br><span class=\"line\">  &lt;/a-modal&gt;</span><br><span class=\"line\">&lt;/template&gt;</span><br><span class=\"line\"></span><br><span class=\"line\">&lt;script setup lang=&quot;ts&quot;&gt;</span><br><span class=\"line\">import &#123; ref &#125; from &#x27;vue&#x27;</span><br><span class=\"line\">import &#123; message &#125; from &#x27;ant-design-vue&#x27;</span><br><span class=\"line\">import &#123; uploadPictureUsingPost &#125; from &#x27;../utils/mockApi.ts&#x27;</span><br><span class=\"line\">// 是否可见</span><br><span class=\"line\">const visible = ref(false)</span><br><span class=\"line\">const cropperRef = ref()</span><br><span class=\"line\"></span><br><span class=\"line\">interface Props &#123;</span><br><span class=\"line\">  imageUrl?: string,</span><br><span class=\"line\">  onSuccess: ((data: any) =&gt; void) | null</span><br><span class=\"line\">&#125;</span><br><span class=\"line\"></span><br><span class=\"line\">const props = defineProps&lt;Props&gt;()</span><br><span class=\"line\">// 打开弹窗</span><br><span class=\"line\">const openModal = () =&gt; &#123;</span><br><span class=\"line\">  visible.value = true</span><br><span class=\"line\">&#125;</span><br><span class=\"line\"></span><br><span class=\"line\"></span><br><span class=\"line\">// 关闭弹窗</span><br><span class=\"line\">const closeModal = () =&gt; &#123;</span><br><span class=\"line\">  visible.value = false;</span><br><span class=\"line\"></span><br><span class=\"line\">&#125;</span><br><span class=\"line\"></span><br><span class=\"line\">const loading = ref&lt;boolean&gt;(false)</span><br><span class=\"line\"></span><br><span class=\"line\">const handleConfirm = () =&gt; &#123;</span><br><span class=\"line\">  cropperRef.value.getCropBlob((blob: Blob) =&gt; &#123;</span><br><span class=\"line\">    const file = new File([blob], &quot;图片&quot;, &#123; type: blob.type &#125;)</span><br><span class=\"line\"></span><br><span class=\"line\">    handleUpload(&#123; file &#125;)</span><br><span class=\"line\">  &#125;)</span><br><span class=\"line\">&#125;</span><br><span class=\"line\"></span><br><span class=\"line\"></span><br><span class=\"line\">const handleUpload = async (&#123; file &#125;: any) =&gt; &#123;</span><br><span class=\"line\">  loading.value = true</span><br><span class=\"line\">  try &#123;</span><br><span class=\"line\">    const params: any = props.imageUrl ? &#123; id: props.imageUrl &#125; : &#123;&#125;</span><br><span class=\"line\">    const res = await uploadPictureUsingPost(params, &#123;&#125;, file)</span><br><span class=\"line\">    if (res.data.code === 0 &amp;&amp; res.data.data) &#123;</span><br><span class=\"line\">      message.success(&#x27;图片上传成功&#x27;)</span><br><span class=\"line\">      if (props.onSuccess) &#123;</span><br><span class=\"line\">        props.onSuccess(res.data.data)</span><br><span class=\"line\">      &#125;</span><br><span class=\"line\">      closeModal();</span><br><span class=\"line\">    &#125; else &#123;</span><br><span class=\"line\">      message.error(&#x27;图片上传失败，&#x27; + res.data.message)</span><br><span class=\"line\">    &#125;</span><br><span class=\"line\">  &#125; catch (error) &#123;</span><br><span class=\"line\">    message.error(&#x27;图片上传失败&#x27;)</span><br><span class=\"line\">  &#125; finally &#123;</span><br><span class=\"line\">    loading.value = false</span><br><span class=\"line\">  &#125;</span><br><span class=\"line\">&#125;</span><br><span class=\"line\">// 向左旋转</span><br><span class=\"line\">const rotateLeft = () =&gt; &#123;</span><br><span class=\"line\">  cropperRef.value.rotateLeft()</span><br><span class=\"line\">&#125;</span><br><span class=\"line\"></span><br><span class=\"line\">// 向右旋转</span><br><span class=\"line\">const rotateRight = () =&gt; &#123;</span><br><span class=\"line\">  cropperRef.value.rotateRight()</span><br><span class=\"line\">&#125;</span><br><span class=\"line\"></span><br><span class=\"line\">// 缩放</span><br><span class=\"line\">const changeScale = (num: number) =&gt; &#123;</span><br><span class=\"line\">  cropperRef.value.changeScale(num)</span><br><span class=\"line\">&#125;</span><br><span class=\"line\"></span><br><span class=\"line\"></span><br><span class=\"line\">// 暴露函数给父组件</span><br><span class=\"line\">defineExpose(&#123;</span><br><span class=\"line\">  openModal</span><br><span class=\"line\">&#125;)</span><br><span class=\"line\"></span><br><span class=\"line\">&lt;/script&gt;</span><br><span class=\"line\"></span><br><span class=\"line\">&lt;style&gt;</span><br><span class=\"line\">.image-cropper &#123;</span><br><span class=\"line\">  text-align: center;</span><br><span class=\"line\">&#125;</span><br><span class=\"line\"></span><br><span class=\"line\">/* .image-cropper .vue-cropper &#123;</span><br><span class=\"line\">  height: 400px !important;</span><br><span class=\"line\">&#125; */</span><br><span class=\"line\"></span><br><span class=\"line\">.vue-cropper &#123;</span><br><span class=\"line\">  height: 400px !important;</span><br><span class=\"line\">&#125;</span><br><span class=\"line\">&lt;/style&gt;</span><br></pre></td></tr></table></figure>\n\n<p>效果如图:</p>\n<p><img src=\"/post/vue-cropper%E6%9C%80%E4%BD%B3%E5%AE%9E%E8%B7%B5/image-20251205134424282.png\" alt=\"image-20251205134424282\"></p>\n<p><img src=\"/post/vue-cropper%E6%9C%80%E4%BD%B3%E5%AE%9E%E8%B7%B5/image-20251205134435810.png\" alt=\"image-20251205134435810\"></p>\n<p><img src=\"/post/vue-cropper%E6%9C%80%E4%BD%B3%E5%AE%9E%E8%B7%B5/image-20251205134442722.png\" alt=\"image-20251205134442722\"></p>\n<p><img src=\"/post/vue-cropper%E6%9C%80%E4%BD%B3%E5%AE%9E%E8%B7%B5/image-20251205134451611.png\" alt=\"image-20251205134451611\"></p>\n<p><img src=\"/post/vue-cropper%E6%9C%80%E4%BD%B3%E5%AE%9E%E8%B7%B5/image-20251205134500340.png\" alt=\"image-20251205134500340\"></p>\n<p>使用<c